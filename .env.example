DATABASE_URL="mongodb+srv://YOUR_MONGODB_USERNAME:YOUR_MONGODB_PASSWORD@cluster0.mongodb.net/employee_leave_db?retryWrites=true&w=majority"
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="YOUR_ADMIN_EMAIL@gmail.com"
SMTP_PASS="YOUR_GMAIL_APP_PASSWORD"
ADMIN_NOTIFY_EMAIL="YOUR_ADMIN_EMAIL@gmail.com"

# AWS CLOUD RESOURCES CONFIGURATION (AWS IAM, S3, SNS, SES, KMS, DYNAMODB, SQS)
AWS_REGION="us-west-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_S3_BUCKET_NAME="YOUR_AWS_S3_BUCKET_NAME"
AWS_SNS_TOPIC_ARN="arn:aws:sns:us-west-1:123456789012:leave-portal-notifications"
AWS_KMS_KEY_ARN="arn:aws:kms:us-west-1:123456789012:key/your-kms-key-id"
AWS_DYNAMODB_TABLE="LeavePortalAuditLogs"
AWS_SQS_QUEUE_URL="https://sqs.us-west-1.amazonaws.com/123456789012/leave-portal-email-queue"
